{
  "name": "miflaga",
  "version": "1.0.0",
  "description": "המפלגה שלי — פלטפורמה להקמת מפלגות הומוריסטיות",
  "scripts": {
    "build": "node scripts/build.mjs",
    "db:migrate:local": "wrangler d1 migrations apply miflaga-db --local",
    "dev": "npm run build && npm run db:migrate:local && wrangler dev --port 8787",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/unit/*.test.mjs\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/e2e.test.mjs",
    "check": "npm test && npm run test:e2e",
    "deploy": "npm run build && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rb077858/my-miflaga.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/rb077858/my-miflaga/issues"
  },
  "homepage": "https://github.com/rb077858/my-miflaga#readme",
  "devDependencies": {
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "qrcode-generator": "^2.0.4"
  },
  "private": true,
  "type": "module"
}
